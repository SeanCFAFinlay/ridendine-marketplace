{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "crons": [
    {
      "path": "/api/engine/processors/sla",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/engine/processors/expired-offers",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/engine/processors/partner-webhooks",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/engine/processors/reconciliation",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/engine/processors/retention",
      "schedule": "0 4 * * *"
    }
  ]
}
